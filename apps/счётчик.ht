# Первое приложение: считает касания и рисует полосу.

app "СЧЁТЧИК" 600 400

фон   = 0xFF0B1020
белый = 0xFFFFFFFF
синий = 0xFF4C8DFF

def полоса(сколько):
    ширина = сколько * 20
    if ширина > 560:
        ширина = 560
    rect(20, 200, ширина, 40, синий)

счёт = 0
живём = 1

while живём:
    rect(0, 0, 600, 400, фон)
    text(20, 40, 4, белый, "КАСАНИЙ")
    textn(400, 40, 4, синий, счёт)
    полоса(счёт)
    show()

    касание = touch()
    if касание < 0:
        живём = 0
    else:
        счёт = счёт + 1
