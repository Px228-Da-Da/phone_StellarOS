# Проверка языка Hittis.
#
# Не приложение, а список утверждений из docs/07-hittis-language.md,
# каждое из которых проверяется на компьютере:
#
#     hittis/hittis apps/проверка.ht /tmp/п.slt && hittis/hostrun /tmp/п.slt
#
# Печатает по строке на утверждение. Любое «НЕ СХОДИТСЯ» значит, что
# справочник разошёлся с языком, и чинить надо одно из двух.

app "ПРОВЕРКА" 0 0

цвет = 0xFF4C8DFF       # шестнадцатеричное число
предел = 100

def проверить(имя_не_нужно, вышло, ждали):
    if вышло == ждали:
        print("СХОДИТСЯ")
    else:
        print("НЕ СХОДИТСЯ:")
        printn(вышло)
    return 0

# Функцию можно звать раньше, чем она определена
def позже(x):
    return x * 2

def глобальную_не_меняю():
    предел = 7           # заводит МЕСТНУЮ, глобальную не трогает
    return предел

def читаю_глобальную():
    return предел

def факториал(n):
    if n < 2:
        return 1
    return n * факториал(n - 1)

def знак(n):
    если = 0
    if n < 0:
        если = 0 - 1
    else:
        if n > 0:
            если = 1
    return если

print("HITTIS: ПРОВЕРКА ЯЗЫКА")

проверить(0, позже(21), 42)
проверить(0, цвет, 4283207167)          # 0xFF4C8DFF, старший бит — часть числа
проверить(0, (65536 * 65536) / 65536, 65536)  # считаем шире, чем пишем
проверить(0, глобальную_не_меняю(), 7)
проверить(0, предел, 100)               # глобальная не изменилась
проверить(0, читаю_глобальную(), 100)
проверить(0, факториал(6), 720)
проверить(0, знак(0 - 5), 0 - 1)
проверить(0, знак(0), 0)
проверить(0, знак(9), 1)
проверить(0, 7 / 2, 3)                  # целочисленное деление
проверить(0, 0 - 7 / 2, 0 - 3)
проверить(0, 7 % 3, 1)
проверить(0, 2 + 3 * 4, 14)             # приоритет операций
проверить(0, (2 + 3) * 4, 20)
проверить(0, 1 < 2, 1)                  # сравнение даёт 1 или 0
проверить(0, 2 < 1, 0)
проверить(0, not 0, 1)
проверить(0, not 5, 0)
проверить(0, 1 and 0, 0)
проверить(0, 0 or 3, 1)                 # or даёт 1, а не 3

счёт = 0
пока = 0
while пока < 5:
    счёт = счёт + пока
    пока = пока + 1
проверить(0, счёт, 10)

print("HITTIS: ПРОВЕРКА ЗАКОНЧЕНА")
