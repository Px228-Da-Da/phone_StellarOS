# ПЛИТКИ — первое приложение StellarOS на Hittis.
#
# Размер в заголовке не написан: приложение занимает весь экран, а
# сколько это в пикселях, оно спрашивает у системы. Так приложение
# остаётся переносимым — числа про конкретный телефон в него не попадают.
#
# Касание приходит одним числом: сверху что произошло, ниже x, ниже y.
# Разбирать его делением — не хитрость, а следствие устройства языка: в
# нём есть только целые числа, и это честно видно.

app "ПЛИТКИ"

синий = 0xFF16203A
яркий = 0xFF2E63C8
фон   = 0xFF0B1020
белый = 0xFFFFFFFF
серый = 0xFF7FD4FF

ширина = width()
высота = height()

# Раскладку считаем от места, а не подбираем числами: плитки делят всю
# высоту под шапкой поровну, и приложение одинаково смотрится и на
# телефоне, и в окне просмотра любого размера.
поле = 40
шапка = 150
плиток = 3
зазор = 24

доступно = высота - шапка - поле
шаг = доступно / плиток
вплитке = шаг - зазор
шириной = ширина - поле * 2

# Какая плитка под точкой; -1 — мимо всех.
#
# Одним делением не обойтись: над плитками y меньше начала, деление даёт
# ноль, и промах становится неотличим от попадания в нулевую плитку.
# Ровно это и случилось на телефоне — палец на заголовке зажигал плитку.
def какая(x, y):
    n = -1
    if y >= шапка:
        n = (y - шапка) / шаг
    if n > плиток - 1:
        n = -1
    if (y - шапка) % шаг > вплитке:
        n = -1
    if x < поле:
        n = -1
    if x > поле + шириной:
        n = -1
    return n

def плитка(n, горит):
    y = шапка + n * шаг
    цвет = синий
    if горит:
        цвет = яркий
    rect(поле, y, шириной, вплитке, цвет)
    text(поле + 40, y + вплитке / 2 - 20, 4, белый, "ПЛИТКА")
    textn(ширина - поле - 60, y + вплитке / 2 - 20, 4, серый, n)

def кадр(горящая, счёт, где):
    rect(0, 0, ширина, высота, фон)
    text(поле, 20, 4, серый, "HITTIS НА STELLAROS")
    text(поле, 85, 3, белый, "КАСАНИЙ")
    textn(поле + 260, 85, 3, яркий, счёт)
    text(поле + 380, 85, 3, белый, "Y")
    textn(поле + 440, 85, 3, яркий, где)
    плитка(0, горящая == 0)
    плитка(1, горящая == 1)
    плитка(2, горящая == 2)
    show()

кадр(-1, 0, 0)
print("HITTIS: ПЛИТКИ ЖДУТ ПАЛЬЦА")

млн = 65536 * 65536
счёт = 0
живём = 1

while живём:
    касание = touch()
    if касание < 0:
        живём = 0
    else:
        действие = касание / (млн * 65536)
        x = (касание / млн) % 65536
        y = касание % млн
        горит = какая(x, y)
        if действие == 2:
            горит = -1
        if действие == 0:
            счёт = счёт + 1
        кадр(горит, счёт, y)

print("HITTIS: КАСАНИЙ БОЛЬШЕ НЕ БУДЕТ, УХОЖУ")
