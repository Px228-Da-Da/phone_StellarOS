# ПЛИТКИ — первое приложение StellarOS на Hittis.
#
# Три плитки во весь экран, под пальцем плитка загорается, сверху счёт
# касаний. Всё, что приложению нужно, оно просит у системы: своей памяти,
# кроме буфера окна, у него нет, и никакого доступа к железу тоже.
#
# Касание приходит одним числом: сверху что произошло, ниже x, ниже y.
# Разбирать его делением — не хитрость, а следствие устройства языка: в
# нём есть только целые числа, и это честно видно.

app "ПЛИТКИ" 720 900

синий = 0xFF16203A
яркий = 0xFF2E63C8
фон   = 0xFF0B1020
белый = 0xFFFFFFFF
серый = 0xFF7FD4FF

ширина = 720
высота = 900
верх = 150
шаг = 250

def плитка(n, горит):
    y = верх + n * шаг
    цвет = синий
    if горит:
        цвет = яркий
    rect(40, y, 640, 210, цвет)
    text(80, y + 80, 4, белый, "ПЛИТКА")
    textn(560, y + 80, 4, серый, n)

def какая(y):
    n = (y - верх) / шаг
    if n < 0:
        n = -1
    if y > верх + шаг * 3:
        n = -1
    return n

def кадр(горящая, счёт, где):
    rect(0, 0, ширина, высота, фон)
    text(40, 20, 4, серый, "HITTIS НА STELLAROS")
    text(40, 85, 3, белый, "КАСАНИЙ")
    textn(300, 85, 3, яркий, счёт)
    text(420, 85, 3, белый, "Y")
    textn(480, 85, 3, яркий, где)
    плитка(0, горящая == 0)
    плитка(1, горящая == 1)
    плитка(2, горящая == 2)
    show()

window(ширина, высота)
кадр(-1, 0, 0)
print("HITTIS: ПЛИТКИ ЖДУТ ПАЛЬЦА")

млн = 65536 * 65536
счёт = 0
живём = 1

while живём:
    касание = touch()
    if касание < 0:
        живём = 0
    else:
        действие = касание / (млн * 65536)
        y = касание % млн
        горит = какая(y)
        if действие == 2:
            горит = -1
        if действие == 0:
            счёт = счёт + 1
        кадр(горит, счёт, y)

print("HITTIS: КАСАНИЙ БОЛЬШЕ НЕ БУДЕТ, УХОЖУ")
