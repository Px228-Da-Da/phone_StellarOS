# Calculator built with qt2.
#
# Никаких rect и text: приложение говорит, из чего состоит, и спрашивает
# экран, какую кнопку нажали. Всё рисование — в библиотеке.
#
# Раскладка считается от размера экрана, а не написана числами. Прошлая
# версия рисовала в прямоугольнике 720x900, а телефон отдаёт приложению
# 1080x2196 — на экране получался маленький калькулятор в углу и чёрное
# поле вокруг. Снаружи это выглядело как зависшая система.

use qt2

app "CALC"

# --- Метки кнопок ----------------------------------------------------
#
# Числами, потому что в языке нет ни перечислений, ни строк, которые
# можно сравнить. Цифры помечаем 100 + сама цифра: так по метке сразу
# видно, цифра это или действие.

OP_ADD = 1
OP_SUB = 2
OP_MUL = 3
OP_DIV = 4
OP_EQ  = 5
OP_CLR = 6


theme = Theme()
screen = Screen(theme.background)

W = width()
H = height()

pad = 40
gap = 16

# Табло сверху, под ним четыре ряда кнопок.
panelH = H / 6
btnW = (W - pad * 2 - gap * 3) / 4
btnH = (H - panelH - pad * 3 - gap * 3) / 4

top = pad + panelH + pad

# screen.place(Label(pad, pad, 3, theme.dim, "CALC"))
display = screen.place(Number(pad, pad + panelH / 3, 8, theme.ink, 0))


# Кнопка на своём месте в сетке.
#
# Ряд и столбец, а не пиксели: раскладка уже посчитана выше, и повторять
# её в каждом вызове значило бы завести четыре шанса ошибиться.
def key(row, col, caption, chars, tag, face):
    x = pad + col * (btnW + gap)
    y = top + row * (btnH + gap)
    b = Button(x, y, btnW, btnH, caption)
    b.center(chars, 5)
    b.mark(tag)
    b.paint(face, theme.accent, theme.ink)
    screen.place(b)
    return b


key(0, 0, "7", 1, 107, theme.face)
key(0, 1, "8", 1, 108, theme.face)
key(0, 2, "9", 1, 109, theme.face)
key(0, 3, "/", 1, OP_DIV, theme.accent)

key(1, 0, "4", 1, 104, theme.face)
key(1, 1, "5", 1, 105, theme.face)
key(1, 2, "6", 1, 106, theme.face)
key(1, 3, "*", 1, OP_MUL, theme.accent)

key(2, 0, "1", 1, 101, theme.face)
key(2, 1, "2", 1, 102, theme.face)
key(2, 2, "3", 1, 103, theme.face)
key(2, 3, "-", 1, OP_SUB, theme.accent)

key(3, 0, "0", 1, 100, theme.face)
key(3, 1, "C", 1, OP_CLR, theme.danger)
key(3, 2, "=", 1, OP_EQ, theme.accent)
key(3, 3, "+", 1, OP_ADD, theme.accent)


first = 0
input = 0
operation = 0
alive = 1


def calculate(a, b, action):
    if action == OP_ADD:
        return a + b
    if action == OP_SUB:
        return a - b
    if action == OP_MUL:
        return a * b
    if action == OP_DIV:
        if b == 0:
            return 0
        return a / b
    return b


screen.draw()
print("CALC: READY")

while alive:
    touchValue = touch()
    if touchValue < 0:
        alive = 0
    else:
        mln = 65536 * 65536
        action = touchValue / (mln * 65536)
        x = (touchValue / mln) % 65536
        y = touchValue % mln

        who = screen.handle(action, x, y)

        if who:
            tag = who.tag

            # Цифра: дописываем справа.
            if tag >= 100:
                input = input * 10 + (tag - 100)

            if tag == OP_CLR:
                first = 0
                input = 0
                operation = 0

            # Действие: запоминаем, что накопили, и ждём второе число.
            if tag > 0:
                if tag < OP_EQ:
                    first = calculate(first, input, operation)
                    if operation == 0:
                        first = input
                    input = 0
                    operation = tag

            if tag == OP_EQ:
                input = calculate(first, input, operation)
                first = 0
                operation = 0

            display.value = input

        screen.draw()

print("CALC: DONE")
