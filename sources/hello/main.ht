# Первое приложение на Hittis.
#
# Читается как питон, но это отдельный язык: внутри только целые числа,
# а строки существуют как готовые постоянные — их можно напечатать или
# вывести на экран.

app "HELLO"

def sum(a, b):
    return a + b

print("HITTIS: HELLO, StellarOS")

x = 2
y = 40
printn(sum(x, y))

i = 0
while i < 3:
    print("HITTIS: ROUND")
    printn(i)
    i = i + 1

if sum(1, 1) == 2:
    print("HITTIS: NUMBERS AGREE")
else:
    print("HITTIS: SOMETHING IS WRONG")
