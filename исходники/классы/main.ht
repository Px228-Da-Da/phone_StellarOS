# Проверка классов: поля, методы, «сам».

app "КЛАССЫ"

class Счёт:
    def создать(сам, начало):
        сам.значение = начало
        сам.шагов = 0
        return 0

    def прибавить(сам, сколько):
        сам.значение = сам.значение + сколько
        сам.шагов = сам.шагов + 1
        return сам.значение

    def показать(сам):
        print("СЧЁТ:")
        printn(сам.значение)
        print("ШАГОВ:")
        printn(сам.шагов)
        return 0

а = Счёт(10)
б = Счёт(100)

а.прибавить(5)
а.прибавить(7)
б.прибавить(1)

а.показать()
б.показать()

print("ПОЛЕ НАПРЯМУЮ:")
printn(б.значение)
