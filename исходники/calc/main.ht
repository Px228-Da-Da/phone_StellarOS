app "КАЛЬКУЛЯТОР"

фон = 0xFF101218
панель = 0xFF1B2029
кнопка = 0xFF252C38
оператор = 0xFF4C8DFF
очистити = 0xFFE05252
білий = 0xFFFFFFFF
сірий = 0xFFB8C0CC

млн = 65536 * 65536

перше = 0
друге = 0
ввід = 0
операція = 0
живемо = 1


def рахувати(а, б, дія):
    if дія == 1:
        return а + б
    else:
        if дія == 2:
            return а - б
        else:
            if дія == 3:
                return а * б
            else:
                if дія == 4:
                    if б == 0:
                        return 0
                    else:
                        return а / б
    return а


while живемо:

    ширина = width()
    висота = height()

    rect(0, 0, ширина, висота, фон)

    # Дисплей

    rect(20, 20, ширина - 40, 140, панель)

    text(45, 45, 2, сірий, "КАЛЬКУЛЯТОР")
    textn(45, 85, 5, білий, ввід)


    # Розміри кнопок

    проміжок = 10
    кнопка_ширина = (ширина - 50) / 4
    кнопка_висота = (висота - 230) / 4

    x1 = 20
    x2 = x1 + кнопка_ширина + проміжок
    x3 = x2 + кнопка_ширина + проміжок
    x4 = x3 + кнопка_ширина + проміжок

    y1 = 190
    y2 = y1 + кнопка_висота + проміжок
    y3 = y2 + кнопка_висота + проміжок
    y4 = y3 + кнопка_висота + проміжок


    # 7 8 9 /

    rect(x1, y1, кнопка_ширина, кнопка_висота, кнопка)
    textn(x1 + 60, y1 + 30, 4, білий, 22)

    rect(x2, y1, кнопка_ширина, кнопка_висота, кнопка)
    textn(x2 + 60, y1 + 30, 4, білий, 8)

    rect(x3, y1, кнопка_ширина, кнопка_висота, кнопка)
    textn(x3 + 60, y1 + 30, 4, білий, 9)

    rect(x4, y1, кнопка_ширина, кнопка_висота, оператор)
    text(x4 + 60, y1 + 30, 4, білий, "/")


    # 4 5 6 *

    rect(x1, y2, кнопка_ширина, кнопка_висота, кнопка)
    textn(x1 + 60, y2 + 30, 4, білий, 4)

    rect(x2, y2, кнопка_ширина, кнопка_висота, кнопка)
    textn(x2 + 60, y2 + 30, 4, білий, 5)

    rect(x3, y2, кнопка_ширина, кнопка_висота, кнопка)
    textn(x3 + 60, y2 + 30, 4, білий, 6)

    rect(x4, y2, кнопка_ширина, кнопка_висота, оператор)
    text(x4 + 60, y2 + 30, 4, білий, "*")


    # 1 2 3 -

    rect(x1, y3, кнопка_ширина, кнопка_висота, кнопка)
    textn(x1 + 60, y3 + 30, 4, білий, 1)

    rect(x2, y3, кнопка_ширина, кнопка_висота, кнопка)
    textn(x2 + 60, y3 + 30, 4, білий, 2)

    rect(x3, y3, кнопка_ширина, кнопка_висота, кнопка)
    textn(x3 + 60, y3 + 30, 4, білий, 3)

    rect(x4, y3, кнопка_ширина, кнопка_висота, оператор)
    text(x4 + 60, y3 + 30, 4, білий, "-")


    # 0 C = +

    rect(x1, y4, кнопка_ширина, кнопка_висота, кнопка)
    textn(x1 + 60, y4 + 30, 4, білий, 0)

    rect(x2, y4, кнопка_ширина, кнопка_висота, очистити)
    text(x2 + 60, y4 + 30, 4, білий, "C")

    rect(x3, y4, кнопка_ширина, кнопка_висота, оператор)
    text(x3 + 60, y4 + 30, 4, білий, "=")

    rect(x4, y4, кнопка_ширина, кнопка_висота, оператор)
    text(x4 + 60, y4 + 30, 4, білий, "+")


    show()


    касание = touch()

    if касание < 0:
        живемо = 0
    else:
        дія_дотику = касание / (млн * 65536)
        x = (касание / млн) % 65536
        y = касание % млн

        if дія_дотику == 2:

            # Ряд 1

            if y >= y1:
                if y < y2:

                    if x >= x1:
                        if x < x2:
                            ввід = ввід * 10 + 7

                    if x >= x2:
                        if x < x3:
                            ввід = ввід * 10 + 8

                    if x >= x3:
                        if x < x4:
                            ввід = ввід * 10 + 9

                    if x >= x4:
                        перше = ввід
                        ввід = 0
                        операція = 4


            # Ряд 2

            if y >= y2:
                if y < y3:

                    if x >= x1:
                        if x < x2:
                            ввід = ввід * 10 + 4

                    if x >= x2:
                        if x < x3:
                            ввід = ввід * 10 + 5

                    if x >= x3:
                        if x < x4:
                            ввід = ввід * 10 + 6

                    if x >= x4:
                        перше = ввід
                        ввід = 0
                        операція = 3


            # Ряд 3

            if y >= y3:
                if y < y4:

                    if x >= x1:
                        if x < x2:
                            ввід = ввід * 10 + 1

                    if x >= x2:
                        if x < x3:
                            ввід = ввід * 10 + 2

                    if x >= x3:
                        if x < x4:
                            ввід = ввід * 10 + 3

                    if x >= x4:
                        перше = ввід
                        ввід = 0
                        операція = 2


            # Ряд 4

            if y >= y4:

                if x >= x1:
                    if x < x2:
                        ввід = ввід * 10


                if x >= x2:
                    if x < x3:
                        перше = 0
                        друге = 0
                        ввід = 0
                        операція = 0


                if x >= x3:
                    if x < x4:
                        друге = ввід
                        ввід = рахувати(перше, друге, операція)
                        перше = ввід
                        операція = 0


                if x >= x4:
                    перше = ввід
                    ввід = 0
                    операція = 1