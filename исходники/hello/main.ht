# Первое приложение на Hittis.
#
# Читается как питон, но это отдельный язык: внутри только целые числа,
# а строки существуют как готовые постоянные — их можно напечатать или
# вывести на экран.

app "ПРИВЕТ"

def сумма(a, b):
    return a + b

print("HITTIS: ЗДРАВСТВУЙ, StellarOS")

x = 2
y = 40
printn(сумма(x, y))

i = 0
while i < 3:
    print("HITTIS: КРУГ")
    printn(i)
    i = i + 1

if сумма(1, 1) == 2:
    print("HITTIS: СЧЁТ СХОДИТСЯ")
else:
    print("HITTIS: ЧТО-ТО НЕ ТАК")
