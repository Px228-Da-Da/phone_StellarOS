# qt2 — user interface for Hittis.
#
# Всё, что рисуется и нажимается, живёт здесь. Приложению остаётся
# сказать, из чего оно состоит, — и один раз в цикле спросить экран,
# куда попал палец.
#
# Подключается строкой «use qt2» в начале программы.
#
# Устройство простое до неприличия, и это намеренно. Виджет обязан уметь
# ровно два действия: нарисовать себя и ответить, попал ли в него палец.
# Больше ничего от него не требуется, поэтому в список экрана можно
# класть что угодно — метод ищется по имени во время работы, и кнопка
# рядом с надписью машине безразличны.
#
# Своего состояния у библиотеки нет: ни глобальных переменных, ни
# скрытого «текущего экрана». Всё, что помнится, лежит в объектах,
# которые завело приложение.

# --- Colors ---------------------------------------------------------
#
# Числами, а не именами: в языке нет ни констант, ни перечислений, а
# заводить под каждый цвет глобальную значило бы занимать имя, которое
# приложению может понадобиться.

class Theme:
    def create(self):
        self.background = 0xFF101218
        self.panel      = 0xFF1B2029
        self.face       = 0xFF252C38
        self.accent     = 0xFF4C8DFF
        self.danger     = 0xFFE05252
        self.ink        = 0xFFFFFFFF
        self.dim        = 0xFFB8C0CC
        return 0


# --- Label ----------------------------------------------------------

class Label:
    def create(self, x, y, size, color, caption):
        self.x = x
        self.y = y
        self.size = size
        self.color = color
        self.caption = caption
        return 0

    def draw(self):
        text(self.x, self.y, self.size, self.color, self.caption)
        return 0

    # Надпись пальца не ловит, но метод нужен: экран спрашивает всех
    # подряд и не обязан знать, кто перед ним.
    def hit(self, px, py):
        return 0

    def press(self, down):
        return 0


# --- Number ---------------------------------------------------------
#
# Отдельный виджет, а не надпись: в языке нет превращения числа в
# строку, и показать счёт можно только отдельным вызовом.

class Number:
    def create(self, x, y, size, color, value):
        self.x = x
        self.y = y
        self.size = size
        self.color = color
        self.value = value
        return 0

    def draw(self):
        textn(self.x, self.y, self.size, self.color, self.value)
        return 0

    def hit(self, px, py):
        return 0

    def press(self, down):
        return 0


# --- Button ---------------------------------------------------------

class Button:
    def create(self, x, y, w, h, caption):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.caption = caption
        self.face = 0xFF252C38
        self.down = 0xFF4C8DFF
        self.ink = 0xFFFFFFFF
        self.pressed = 0
        # Подпись: размер и откуда её рисовать внутри кнопки.
        self.size = 4
        self.left = 20
        self.top = h / 2 - 16
        # Чем кнопку пометило приложение: свой номер, код, что угодно.
        # Библиотека в это значение не смотрит вовсе.
        self.tag = 0
        return 0

    # Поставить подпись по центру.
    #
    # Ширину спрашиваем у системы через textw(). Раньше её приходилось
    # угадывать: приложение передавало сюда количество букв, а ширина
    # считалась как «букв × размер × 2», то есть шрифт молча считался
    # равноширинным.
    #
    # Он не равноширинный. Ядро меряет строку по начертаниям — «Ж» шире
    # «i», — и подпись из одного-двух знаков стояла почти ровно только
    # по случайности. На словах ошибка накапливалась, и «по центру»
    # переставало быть центром.
    def center(self, size):
        self.size = size
        self.left = self.w / 2 - textw(size, self.caption) / 2
        self.top = self.h / 2 - size * 4
        return self

    def paint(self, face, down, ink):
        self.face = face
        self.down = down
        self.ink = ink
        return 0

    def mark(self, tag):
        self.tag = tag
        return self

    def draw(self):
        color = self.face
        if self.pressed:
            color = self.down
        rect(self.x, self.y, self.w, self.h, color)
        text(self.x + self.left, self.y + self.top, self.size, self.ink,
             self.caption)
        return 0

    def hit(self, px, py):
        if px < self.x:
            return 0
        if px > self.x + self.w:
            return 0
        if py < self.y:
            return 0
        if py > self.y + self.h:
            return 0
        return 1

    def press(self, down):
        self.pressed = down
        return 0


# --- QLineEdit ------------------------------------------------------
#
# Поле ввода: одна строка текста, которую набирают снаружи.
#
# Набранное хранится списком кодов, а не строкой, и это не причуда.
# Строки в языке существуют только как готовые постоянные: сложить новую
# нельзя, узнать длину нельзя, добраться до буквы нельзя. Зато список
# чисел есть, а нарисовать знак по коду умеет textc — он же сообщает его
# ширину, потому что шрифт не равноширинный и выстроить буквы иначе не
# получится.
#
# Клавиатуры библиотека не содержит намеренно: какие знаки нужны этому
# приложению, знает только оно. Кнопка передаёт код в put(), и всё.

class QLineEdit:
    def create(self, x, y, w, h, size):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.size = size
        self.codes = []
        self.face = 0xFF1B2029
        self.edge = 0xFF4C8DFF
        self.ink = 0xFFFFFFFF
        self.focus = 0
        self.tag = 0
        return 0

    def paint(self, face, edge, ink):
        self.face = face
        self.edge = edge
        self.ink = ink
        return 0

    def mark(self, tag):
        self.tag = tag
        return self

    # Добавить знак по коду
    def put(self, code):
        add(self.codes, code)
        return len(self.codes)

    # Стереть последний. Списка короче язык не умеет, поэтому переписываем
    # всё, кроме хвоста: поле короткое, и это дешевле, чем заводить в
    # машине укорачивание ради одного случая.
    def back(self):
        old = self.codes
        self.codes = []
        i = 0
        while i < len(old) - 1:
            add(self.codes, old[i])
            i = i + 1
        return len(self.codes)

    def clear(self):
        self.codes = []
        return 0

    def length(self):
        return len(self.codes)

    def at(self, i):
        return self.codes[i]

    def draw(self):
        rect(self.x, self.y, self.w, self.h, self.face)
        if self.focus:
            rect(self.x, self.y + self.h - 4, self.w, 4, self.edge)

        pen = self.x + 16
        top = self.y + self.h / 2 - self.size * 4
        i = 0
        while i < len(self.codes):
            pen = pen + textc(pen, top, self.size, self.ink, self.codes[i])
            i = i + 1

        # Черта на месте следующего знака: без неё не видно, куда пишут.
        if self.focus:
            rect(pen + 4, top, 3, self.size * 8, self.ink)
        return 0

    def hit(self, px, py):
        if px < self.x:
            return 0
        if px > self.x + self.w:
            return 0
        if py < self.y:
            return 0
        if py > self.y + self.h:
            return 0
        return 1

    def press(self, down):
        if down:
            self.focus = 1
        return 0


# --- Screen ---------------------------------------------------------
#
# Экран держит список виджетов и знает про палец ровно одно: какому
# виджету он достался. Что с этим делать, решает приложение.

class Screen:
    def create(self, background):
        self.background = background
        self.items = []
        self.held = 0
        return 0

    def place(self, item):
        add(self.items, item)
        return item

    def draw(self):
        rect(0, 0, width(), height(), self.background)
        i = 0
        while i < len(self.items):
            self.items[i].draw()
            i = i + 1
        show()
        return 0

    # Кто под точкой; 0 — никто.
    def at(self, px, py):
        i = 0
        while i < len(self.items):
            if self.items[i].hit(px, py):
                return self.items[i]
            i = i + 1
        return 0

    # Разобрать касание и вернуть виджет, который нажали и отпустили.
    #
    # Возвращается только на отпускании и только если палец отпустили
    # там же, где нажали, — так ведёт себя всякий приличный интерфейс:
    # уведя палец в сторону, нажатие можно отменить.
    def handle(self, action, px, py):
        who = self.at(px, py)

        if action == 0:
            if who:
                who.press(1)
                self.held = who
            return 0

        if action == 1:
            if self.held:
                if who == self.held:
                    self.held.press(1)
                else:
                    self.held.press(0)
            return 0

        # Отпустили
        if self.held:
            self.held.press(0)
            if who == self.held:
                self.held = 0
                return who
            self.held = 0
        return 0
